meta {
  name: text query
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/chat/query
  body: json
  auth: inherit
}

headers {
  X-External-Auth-Id: {{authId}}
  X-Auth-Provider: {{authProvider}}
  X-User-Type: {{userType}}
  X-User-Email: {{userEmail}}
  Content-Type: application/json
}

body:json {
  {
    "conversation_id": 1,
    "message": "Cuales son los requisitos para regularizar una materia?"
  }
}
