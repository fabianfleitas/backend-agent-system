meta {
  name: list documents
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/admin/documents
  body: none
  auth: inherit
}

headers {
  X-External-Auth-Id: {{authId}}
  X-Auth-Provider: {{authProvider}}
  X-User-Type: {{adminType}}
  X-User-Email: {{userEmail}}
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8000
  adminType: ADMIN
}
