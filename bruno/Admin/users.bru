meta {
  name: users
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/admin/users
  body: none
  auth: inherit
}

params:query {
  limit: 20
  offset: 0
}

headers {
  X-External-Auth-Id: {{authId}}
  X-Auth-Provider: {{authProvider}}
  X-User-Type: {{adminType}}
  X-User-Email: {{userEmail}}
}
