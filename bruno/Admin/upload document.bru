meta {
  name: upload document
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/admin/documents
  body: multipartForm
  auth: inherit
}

headers {
  X-External-Auth-Id: {{authId}}
  X-Auth-Provider: {{authProvider}}
  X-User-Type: {{adminType}}
  X-User-Email: {{userEmail}}
}

body:multipartForm {
  file: @file(./documento.pdf)
  titulo: Reglamento Academico
  descripcion: Documento institucional de reglamentos
  categoria_id: 1
  codigo_documento: REG-001
}
