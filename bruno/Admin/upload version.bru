meta {
  name: upload version
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/admin/documents/{{documentoId}}/versions
  body: multipartForm
  auth: inherit
}

headers {
  X-External-Auth-Id: {{authId}}
  X-Auth-Provider: {{authProvider}}
  X-User-Type: {{adminType}}
  X-User-Email: {{userEmail}}
}

body:multipartForm {
  file: @file(./documento.pdf)
}
