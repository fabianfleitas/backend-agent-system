# Evaluación (S12) — configuración opcional
# Copiar a eval/.env o exportar. Todo es opcional.

# Modo API real (vacío = in-process local con auth sobrescrita)
EVAL_API_URL=http://localhost:8000
# Token JWT de Supabase (solo modo API)
EVAL_AUTH_TOKEN=

# Conversación a usar (vacío = autocrear una)
EVAL_CONVERSATION_ID=

# Identidad para el modo in-process (auth sobrescrita)
EVAL_USER_ID=eval-user
EVAL_INSTITUCION_ID=1