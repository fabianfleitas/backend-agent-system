@startuml
skinparam backgroundColor #FEFEFE
skinparam groupInheritance 3
skinparam lollipopArrowColor #AAAAAA

title ER Diagram — backend-agent-system (tables.sql)

left to right direction

package "Usuarios / Institucion" {
  entity app_users {
    * id : bigint <<PK>>
    --
    * external_auth_id : text <<UQ>>
    * email : text
    * full_name : text
    * role : user_role
    * is_active : bool
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity instituciones {
    * id : bigint <<PK>>
    --
    * nombre : text
    * nombre_comercial : text
    * codigo : text <<UQ>>
    * activo : bool
    * stripe_customer_id : text <<UQ>>
    * pais : text
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity institucion_miembros {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * external_auth_id : text <<FK>>
    * tipo_miembro : text
    * activo : bool
    * fecha_ingreso : timestamptz
    * fecha_salida : timestamptz
  }

  entity platform_admins {
    * id : bigint <<PK>>
    --
    * external_auth_id : text <<UQ>> <<FK>>
    * is_active : bool
  }
}

package "Documentos / RAG" {
  entity categorias {
    * id : bigint <<PK>>
    --
    * nombre : text <<UQ>>
    * descripcion : text
    * activo : bool
    * institucion_id : bigint <<FK>>
    * orden : int
    * fecha_baja : timestamptz
  }

  entity documentos {
    * id : bigint <<PK>>
    --
    * categoria_id : bigint <<FK>>
    * codigo_documento : text <<UQ>>
    * titulo : text
    * descripcion : text
    * activo : bool
    * institucion_id : bigint <<FK>>
    * fecha_creacion : timestamptz
  }

  entity documento_versiones {
    * id : bigint <<PK>>
    --
    * documento_id : bigint <<FK>>
    * numero_version : int
    * ruta_archivo : text
    * mime_type : text
    * file_size_bytes : bigint
    * status : document_status
    * es_version_activa : bool
    * texto_extraido : text
    * total_chunks : int
    * embedding_model : text
    * indexed_at : timestamptz
    * fecha_carga : timestamptz
    * cargado_por_external_auth_id : text <<FK>>
  }

  entity document_chunks {
    * id : bigint <<PK>>
    --
    * documento_version_id : bigint <<FK>>
    * chunk_index : int
    * page_number : int
    * chunk_text : text
    * token_count : int
  }

  entity document_embeddings {
    * id : bigint <<PK>>
    --
    * chunk_id : bigint <<FK>>
    * embedding : embedding
    * embedding_model : text
  }
}

package "Conversaciones / Mensajes / Auditoria" {
  entity conversaciones {
    * id : bigint <<PK>>
    --
    * external_auth_id : text <<FK>>
    * title : text
    * hidden : bool
    * last_interaction : timestamptz
    * institucion_id : bigint <<FK>>
  }

  entity mensajes {
    * id : bigint <<PK>>
    --
    * conversacion_id : bigint <<FK>>
    * external_auth_id : text <<FK>>
    * rol_mensaje : message_role
    * contenido_texto : text
    * proveedor_ia : text
    * modelo_ia : text
    * tokens_input : int
    * tokens_output : int
    * tiempo_respuesta_ms : int
    * audit_id : uuid <<FK>>
    * fecha_envio : timestamptz
  }

  entity audit_logs {
    * id : uuid <<PK>>
    --
    * conversacion_id : bigint <<FK>>
    * mensaje_id : bigint <<FK>>
    * external_auth_id : text <<FK>>
    * pregunta_anonimizada : text
    * respuesta_texto : text
    * embedding_model : text
    * score_fidelidad : numeric
    * score_relevancia : numeric
    * score_contexto : numeric
    * observaciones : text
    * fecha_evaluacion : timestamptz
    * institucion_id : bigint <<FK>>
  }

  entity message_documents {
    * id : bigint <<PK>>
    --
    * mensaje_id : bigint <<FK>>
    * audit_id : uuid <<FK>>
    * documento_id : bigint <<FK>>
    * documento_version_id : bigint <<FK>>
    * chunk_id : bigint <<FK>>
    * similarity_score : double
    * page_number : int
  }

  entity feedback {
    * id : bigint <<PK>>
    --
    * message_id : bigint <<FK>>
    * audit_id : uuid <<FK>>
    * external_auth_id : text <<FK>>
    * rating : int
    * comment : text
    * institucion_id : bigint <<FK>>
  }

  entity audio_interactions {
    * id : bigint <<PK>>
    --
    * conversacion_id : bigint <<FK>>
    * mensaje_id : bigint <<FK>>
    * external_auth_id : text <<FK>>
    * ruta_audio_original : text
    * ruta_audio_respuesta : text
    * transcripcion : text
    * duracion_segundos : numeric
    * institucion_id : bigint <<FK>>
  }

  entity pii_mappings {
    * id : bigint <<PK>>
    --
    * audit_id : uuid <<FK>>
    * external_auth_id : text <<FK>>
    * token : text
    * pii_type : text
    * original_value : text
    * institucion_id : bigint <<FK>>
    * expires_at : timestamptz
  }
}

package "Billing / Suscripciones" {
  entity planes {
    * id : bigint <<PK>>
    --
    * codigo : text <<UQ>>
    * nombre : text
    * precio : numeric
    * moneda : bpchar
    * intervalo : text
    * max_documentos : int
    * features : jsonb
  }

  entity suscripciones {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * plan_id : bigint <<FK>>
    * estado : text
    * stripe_subscription_id : text <<UQ>>
    * auto_renovacion : bool
  }

  entity suscripcion_historial {
    * id : bigint <<PK>>
    --
    * suscripcion_id : bigint <<FK>>
    * tipo_evento : text
    * plan_anterior_id : bigint <<FK>>
    * plan_nuevo_id : bigint <<FK>>
    * external_auth_id : text <<FK>>
  }

  entity pagos {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * suscripcion_id : bigint <<FK>>
    * importe : numeric
    * estado : text
    * stripe_payment_intent_id : text <<UQ>>
    * stripe_charge_id : text
  }

  entity stripe_eventos {
    * id : bigint <<PK>>
    --
    * stripe_event_id : text <<UQ>>
    * tipo_evento : text
    * payload : jsonb
    * procesado : bool
  }

  entity comprobantes {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * pago_id : bigint <<FK>>
    * tipo_comprobante : text
    * numero : text
    * estado : text
  }

  entity notificaciones {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * suscripcion_id : bigint <<FK>>
    * tipo : text
    * canal : text
    * destinatario : text
    * estado : text
    * clave_idempotencia : text <<UQ>>
  }
}

package "Configuracion / Email" {
  entity configuracion_smtp {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * servidor : text
    * cifrado : text
    * correo_remitente : text
    * activo : bool
  }

  entity plantillas_email {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * codigo : text
    * asunto : text
    * contenido_html : text
    * activo : bool
  }

  entity config_parametros {
    * id : bigint <<PK>>
    --
    * institucion_id : bigint <<FK>>
    * clave : text
    * valor : text
    * editable_desde_dashboard : bool
    * activo : bool
  }
}

' Relaciones centrales
app_users ||--o{ institucion_miembros : "miembro de"
app_users ||--o{ conversaciones     : "crea"
app_users ||--o{ mensajes            : "envia"
app_users ||--o{ audit_logs          : "autor"
app_users ||--o{ audio_interactions  : "usa"
app_users ||--o{ feedback            : "califica"
app_users ||--o{ documento_versiones : "carga"
app_users ||--o{ pii_mappings        : "mapea"
app_users ||--|| platform_admins     : "es admin"

instituciones ||--o{ categorias        : "tiene"
instituciones ||--o{ documentos        : "tiene"
instituciones ||--o{ conversaciones    : "tiene"
instituciones ||--o{ audit_logs        : "tiene"
instituciones ||--o{ audio_interactions : "tiene"
instituciones ||--o{ feedback          : "recibe"
instituciones ||--o{ institucion_miembros : "tiene"
instituciones ||--o{ suscripciones     : "tiene"
instituciones ||--o{ pagos             : "tiene"
instituciones ||--o{ comprobantes      : "tiene"
instituciones ||--o{ notificaciones    : "tiene"
instituciones ||--o{ configuracion_smtp : "config"
instituciones ||--o{ plantillas_email  : "templ"
instituciones ||--o{ config_parametros  : "param"

categorias ||--o{ documentos : "clasifica"
documentos ||--o{ documento_versiones : "versiona"
documento_versiones ||--o{ document_chunks : "divide"
document_chunks ||--o{ document_embeddings : "embede"
document_chunks ||--o{ message_documents : "referencia"
documento_versiones ||--o{ message_documents : "referencia"
documentos ||--o{ message_documents : "referencia"

conversaciones ||--o{ mensajes             : "contiene"
conversaciones ||--o{ audit_logs           : "audita"
conversaciones ||--o{ audio_interactions   : "tiene"

mensajes ||--o{ audit_logs        : "audita"
mensajes ||--o{ message_documents : "referencia"
mensajes ||--o{ feedback          : "califica"
mensajes ||--o{ audio_interactions : "tiene"

audit_logs ||--o{ message_documents : "referencia"
audit_logs ||--o{ feedback          : "evalua"
audit_logs ||--o{ pii_mappings      : "mapea"

planes ||--o{ suscripciones : "ofrece"
planes ||--o{ suscripcion_historial : "historia"
suscripciones ||--o{ suscripcion_historial : "historial"
suscripciones ||--o{ pagos : "paga"
suscripciones ||--o{ notificaciones : "notifica"
pagos ||--o{ comprobantes : "comprobante"

@enduml
