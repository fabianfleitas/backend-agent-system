erDiagram
    %% Usuarios / Institución
    app_users {
        bigint id PK
        text external_auth_id UK
        text email
        text full_name
        string role
        bool is_active
        timestamptz created_at
        timestamptz updated_at
    }
    instituciones {
        bigint id PK
        text nombre
        text nombre_comercial
        text codigo UK
        bool activo
        text stripe_customer_id UK
        text pais
        timestamptz created_at
        timestamptz updated_at
    }
    institucion_miembros {
        bigint id PK
        bigint institucion_id FK
        text external_auth_id FK
        text tipo_miembro
        bool activo
        timestamptz fecha_ingreso
        timestamptz fecha_salida
    }
    platform_admins {
        bigint id PK
        text external_auth_id FK
        boolean is_active
    }

    %% Documentos / RAG
    categorias {
        bigint id PK
        text nombre UK
        text descripcion
        bool activo
        bigint institucion_id FK
        int orden
        timestamptz fecha_baja
    }
    documentos {
        bigint id PK
        bigint categoria_id FK
        text codigo_documento UK
        text titulo
        text descripcion
        bool activo
        bigint institucion_id FK
        timestamptz fecha_creacion
    }
    documento_versiones {
        bigint id PK
        bigint documento_id FK
        int numero_version
        text ruta_archivo
        text mime_type
        bigint file_size_bytes
        string status
        bool es_version_activa
        text texto_extraido
        int total_chunks
        text embedding_model
        timestamptz indexed_at
        timestamptz fecha_carga
        text cargado_por_external_auth_id FK
    }
    document_chunks {
        bigint id PK
        bigint documento_version_id FK
        int chunk_index
        int page_number
        text chunk_text
        int token_count
    }
    document_embeddings {
        bigint id PK
        bigint chunk_id FK
        text embedding
        text embedding_model
    }

    %% Conversaciones / Mensajes / Auditoría
    conversaciones {
        bigint id PK
        text external_auth_id FK
        text title
        bool hidden
        timestamptz last_interaction
        timestamptz fecha_creacion
        bigint institucion_id FK
    }
    mensajes {
        bigint id PK
        bigint conversacion_id FK
        text external_auth_id FK
        string rol_mensaje
        text contenido_texto
        text proveedor_ia
        text modelo_ia
        float temperatura
        int tokens_input
        int tokens_output
        int tiempo_respuesta_ms
        uuid audit_id FK
        timestamptz fecha_envio
    }
    audit_logs {
        uuid id PK
        bigint conversacion_id FK
        bigint mensaje_id FK
        text external_auth_id FK
        text pregunta_original
        text pregunta_anonimizada
        text respuesta_texto
        text proveedor_ia
        text modelo_ia
        text embedding_model
        int tokens_input
        int tokens_output
        int tiempo_respuesta_ms
        float score_fidelidad
        float score_relevancia
        float score_contexto
        text observaciones
        timestamptz fecha_evaluacion
        bigint institucion_id FK
    }
    message_documents {
        bigint id PK
        bigint mensaje_id FK
        uuid audit_id FK
        bigint documento_id FK
        bigint documento_version_id FK
        bigint chunk_id FK
        double similarity_score
        int page_number
    }
    feedback {
        bigint id PK
        bigint message_id FK
        uuid audit_id FK
        text external_auth_id FK
        int rating
        text comment
        bigint institucion_id FK
    }
    audio_interactions {
        bigint id PK
        bigint conversacion_id FK
        bigint mensaje_id FK
        text external_auth_id FK
        text ruta_audio_original
        text ruta_audio_respuesta
        text transcripcion
        text transcription_model
        float duracion_segundos
        text formato_audio
        bigint tamano_bytes
        bigint institucion_id FK
    }
    pii_mappings {
        bigint id PK
        uuid audit_id FK
        text external_auth_id FK
        text token
        text pii_type
        text original_value
        bigint institucion_id FK
        timestamptz expires_at
    }

    %% Billing / Suscripciones
    planes {
        bigint id PK
        text codigo UK
        text nombre
        text descripcion
        float precio
        string moneda
        text intervalo
        int max_documentos
        int max_usuarios
        int max_estudiantes
        string features
        text stripe_product_id UK
        text stripe_price_id UK
    }
    suscripciones {
        bigint id PK
        bigint institucion_id FK
        bigint plan_id FK
        text estado
        text stripe_subscription_id UK
        bool auto_renovacion
    }
    suscripcion_historial {
        bigint id PK
        bigint suscripcion_id FK
        text tipo_evento
        bigint plan_anterior_id FK
        bigint plan_nuevo_id FK
        text estado_anterior
        text estado_nuevo
        text descripcion
        text external_auth_id FK
    }
    pagos {
        bigint id PK
        bigint institucion_id FK
        bigint suscripcion_id FK
        float importe
        string moneda
        text estado
        text stripe_payment_intent_id UK
        text stripe_charge_id
    }
    stripe_eventos {
        bigint id PK
        text stripe_event_id UK
        text tipo_evento
        jsonb payload
        bool procesado
    }
    comprobantes {
        bigint id PK
        bigint institucion_id FK
        bigint pago_id FK
        text tipo_comprobante
        text numero
        text estado
    }
    notificaciones {
        bigint id PK
        bigint institucion_id FK
        bigint suscripcion_id FK
        text tipo
        text canal
        text destinatario
        text asunto
        text contenido
        text estado
        text clave_idempotencia UK
    }

    %% Configuración / Email
    configuracion_smtp {
        bigint id PK
        bigint institucion_id FK
        text servidor
        int puerto
        text cifrado
        text usuario
        text password_secret_ref
        text correo_remitente
        text nombre_remitente
        int timeout_segundos
        bool activo
    }
    plantillas_email {
        bigint id PK
        bigint institucion_id FK
        text codigo
        text nombre
        text asunto
        text contenido_html
        bool activo
    }
    config_parametros {
        bigint id PK
        bigint institucion_id FK
        text clave
        text valor
        text tipo
        bool editable_desde_dashboard
        bool activo
    }

