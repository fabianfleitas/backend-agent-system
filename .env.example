# Core
APP_NAME=backend-agent-system
ENVIRONMENT=local

# Supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=example
SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
SUPABASE_STORAGE_BUCKET_AUDIO=audio

# Backup (RNF-06): connection string de Postgres para pg_dump
# Ej.: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7

# IA / LLM
OPENAI_API_KEY=sk-example
OPENROUTER_API_KEY=sk-example
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Precedencia: config_parametros.llm_model (institucional > global) > este .env.
LLM_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
LLM_MAX_TOKENS=384
# Enrutamiento de OpenRouter para generación (coma-separado). La configuración
# adoptada fuerza Groq y desactiva fallbacks para priorizar baja latencia.
LLM_PROVIDER_ORDER=Groq
LLM_PROVIDER_ALLOW_FALLBACKS=false
# Nivel de razonamiento para modelos que lo soportan: low|medium|high.
LLM_REASONING_EFFORT=low
LLM_HISTORY_ENABLED=true
# LLM-as-a-Judge (evaluación de calidad de respuestas; activable/desactivable)
# RNF-05: en interactivo el juez queda fuera de la ruta crítica. Si se activa,
# JUDGE_SAMPLE_RATE controla qué fracción de consultas se evalúa (0.0–1.0).
# Precedencia: config_parametros (BD) > este .env > default del código.
# Si existe la fila en BD, el valor de BD manda. Para A/B, ajustar la fila
# (global o institucional) a 1.0 y restaurarla a 0.0 al terminar.
JUDGE_ENABLED=false
JUDGE_SAMPLE_RATE=0.0
# Precedencia: config_parametros.judge_model (institucional > global) > este .env.
JUDGE_MODEL=openai/gpt-4o-mini
JUDGE_TEMPERATURE=0
JUDGE_MAX_TOKENS=256
JUDGE_REQUEST_TIMEOUT=45

# Derivación a operador humano (escalamiento por notificaciones)
HANDOFF_ENABLED=false
HANDOFF_TRIGGER_ON_GUARD=true
HANDOFF_TRIGGER_ON_LLM_FAILURE=true
HANDOFF_FRUSTRATION_ENABLED=false

# Embeddings / RAG
EMBEDDINGS_ENABLED=true
# Recuperación: menos fragmentos = menos contexto al LLM y menor latencia.
RETRIEVAL_MATCH_COUNT=4

# Voz
STT_ENABLED=true
STT_MODEL=x-ai/grok-stt-1.0
STT_RESPONSE_FORMAT=verbose_json
TTS_ENABLED=true
TTS_MODEL=hexgrad/kokoro-82m
TTS_VOICE=ef_dora
TTS_RESPONSE_FORMAT=mp3

# SMTP (notificaciones por email)
SMTP_PASSWORD=

# Casilla de plataforma que recibe el aviso de cada solicitud de acceso.
# Si queda vacía, la solicitud se guarda igual pero no se envía aviso.
SOLICITUDES_EMAIL=

# Stripe (pasarela de pagos)
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example
STRIPE_API_VERSION=2024-06-20
STRIPE_ACCOUNT_ID=

# PII / Anonimización
# Requiere el modelo spaCy instalado: python -m spacy download es_core_news_md
PII_ANONYMIZATION_ENABLED=false
PII_MAPPING_RETENTION_DAYS=90
PII_NLP_MODEL=es_core_news_md
PII_LANGUAGE=es

# Rate limiting (token bucket in-memory, por proceso)
# NOTA: el bucket es por proceso (in-memory). Con múltiples workers de uvicorn,
# cada proceso tiene su propio contador; no es un límite global distribuido.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_RULES=/api/chat/query:20:60,/api/chat/voice:10:60,/api/chat/feedback:30:60,/api/admin/documents:30:60,/api/admin/reindex:10:60,/api/admin/stripe:10:60,/api/public/solicitudes-acceso:5:60
